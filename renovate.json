{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "automergeType": "branch",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-4 * * *"],
    "automerge": true
  },
  "semanticCommits": "enabled",
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "matchManagers": ["deno"],
      "matchDepTypes": ["imports"],
      "semanticCommitType": "fix"
    },
    {
      "matchManagers": ["deno"],
      "matchDepTypes": ["imports"],
      "matchPackageNames": [
        "@faker-js/faker",
        "@happy-dom/global-registrator",
        "@std/assert",
        "@std/testing",
        "@testing-library/preact",
        "@types/morgan",
        "@types/sinon",
        "morgan",
        "puppeteer",
        "sinon"
      ],
      "semanticCommitType": "chore",
      "automerge": true
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["denoland/deno"],
      "versionCompatibility": "^((?<compatibility>.*)-)?(?<version>.*)$",
      "versioning": "semver"
    },
    {
      "matchPackageNames": ["denoland/deno", "deno"],
      "groupName": "Deno",
      "semanticCommitType": "fix"
    },
    {
      "description": "Do not require Minimum Release Age for update types that are controlled by the package manager",
      "matchUpdateTypes": ["lockFileMaintenance"],
      "minimumReleaseAge": null
    },
    {
      "description": "Disable update PRs (in favor of lock file maintenance) for mise tools with requested version being latest",
      "matchDepTypes": ["tools"],
      "matchCurrentValue": "latest",
      "enabled": false
    }
  ]
}
