amends "package://github.com/jdx/hk/releases/download/v2.8.0/hk@2.8.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.8.0/hk@2.8.0#/Builtins.pkl"

steps {
  ["betterleaks"] = Builtins.betterleaks
  ["check-dev-deps"] {
    env {
      ["MISE_QUIET"] = "true"
    }
    glob = List("deno.jsonc", "renovate.json")
    check = "mise run check-dev-deps"
  }
  ["deno"] = Builtins.deno
  ["deno-check"] = Builtins.deno_check
  ["deno-lint"] {
    glob = List("**/*.js", "**/*.jsx", "**/*.ts", "**/*.tsx")
    check = "deno lint {{ files }}"
    fix = "deno lint --fix {{ files }}"
  }
  ["editorconfig-checker"] = Builtins.editorconfig_checker
  ["ghalint"] = Builtins.ghalint_workflow
  ["hadolint"] = Builtins.hadolint
  ["jactionlint"] = Builtins.jactionlint
  ["pinact"] = Builtins.pinact
  ["pkl"] = Builtins.pkl
  ["pkl-format"] = Builtins.pkl_format
  ["rumdl"] = Builtins.rumdl
  ["tombi"] = Builtins.tombi
  ["typos"] = Builtins.typos
}

exclude = "CHANGELOG.md"

hooks {
  ["commit-msg"] {
    steps {
      ["check-conventional-commit"] = Builtins.check_conventional_commit
    }
  }
}
